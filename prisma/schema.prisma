generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Product {
  id          String   @id @default(uuid())
  name        String
  price       Decimal
  quantity    Int
  created_at  DateTime @default(now())

  @@map("products")
}