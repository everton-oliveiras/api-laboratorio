generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Product {
  id          String   @id @default(uuid())
  name        String
  price       Decimal
  quantity    Int
  created_at  DateTime @default(now())

  @@map("products")
}

model Client {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique  // @unique garante que não existam 2 clientes com mesmo email
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  @@map("clients")
}